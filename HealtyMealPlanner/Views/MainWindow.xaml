<Window x:Class="HealthyMealPlanner.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HealthyMealPlanner.ViewModels"
        Title="Healthy Meal Planner" 
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="CanResize"  
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource LightGreenBrush}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" 
                Background="{StaticResource PrimaryGreenBrush}" 
                CornerRadius="0,0,20,20"
                Padding="10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Image Source= "/Icons/broccoli.png" Width="30" Height="30" Margin="0,0,10,0"/>
                    <TextBlock Text="Healthy Meal Planner"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
            Orientation="Horizontal"
            VerticalAlignment="Center"
            Margin="0,0,30,0"
            HorizontalAlignment="Right">

                    <Button Click="Logout_Click"
            Background="White"
            Foreground="{StaticResource PrimaryGreenBrush}"
            FontWeight="Bold"
            Padding="8,4"
            BorderBrush="Transparent"
            BorderThickness="0"
            Cursor="Hand"
            Margin="0"
            HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Logout" FontSize="14"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" 
                    Background="#F0FDF4"
                    CornerRadius="24"
                    Padding="20"
                    Margin="20"
                    Effect="{StaticResource ShadowEffect}">
                <StackPanel VerticalAlignment="Top">
                    <Button Content="🏠  Home"
                            Click="LoadHomepage"
                            Style="{StaticResource NavigationButton}"
                            Margin="0,0,0,10"/>
                    <Button Content="👤  Profile"
                            Click="LoadProfile"
                            Style="{StaticResource NavigationButton}"
                            Margin="0,0,0,10"/>
                    <Button Content="📅  Meal Plans"
                            Click= "LoadMealPlans"
                            Style="{StaticResource NavigationButton}"
                            Margin="0,0,0,10"/>
                    <Button Content="🍽️  Recipes"
                            Click="LoadRecipeBrowser"
                            Style="{StaticResource NavigationButton}"
                            Margin="0,0,0,10"/>
                    <Button Content=" ★   Favorites"
                            Click="LoadFavorites"
                            Style="{StaticResource NavigationButton}"
                            Margin="0,0,0,10"/>
                    <Button Content="📊  Dashboard"
                            Click="LoadDashboard"
                            Style="{StaticResource NavigationButton}"
                            Margin="0,0,0,10"
                            Visibility="Collapsed"
                            x:Name="DashboardButton"/>
                </StackPanel>
            </Border>

            <ContentControl x:Name="MainContent" 
                            Grid.Column="1" 
                            Margin="10,0,20,20"/>
        </Grid>
    </Grid>
</Window>
