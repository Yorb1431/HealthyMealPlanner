<UserControl x:Class="HealthyMealPlanner.Views.Profile.UserProfile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Border CornerRadius="20" 
            Background="#F9FAFB" 
            Padding="10" 
            Margin="20" 
            BorderBrush="#E5E7EB" 
            BorderThickness="1"
            Effect="{StaticResource ShadowEffect}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header with back button -->
                <StackPanel Grid.Row="0" Margin="0,0,0,30" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="←" Width="40" Height="40" FontSize="20" Background="White" Foreground="#16A34A"
                        BorderBrush="#D1D5DB" BorderThickness="1" Cursor="Hand" Click="BackButton_Click" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="👤 User Profile" FontSize="28" FontWeight="Bold" Foreground="#16A34A"/>
                        <TextBlock Text="Update your personal health info and goals" FontSize="14" Foreground="Gray"/>
                    </StackPanel>
                </StackPanel>

                <!-- Profile panel -->
                <Border Grid.Row="1" Background="White" CornerRadius="20" Padding="0" BorderBrush="#E5E7EB" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: profile image and name -->
                        <Border Grid.Column="0"
                            Background="#16A34A"
                            CornerRadius="20"
                            Padding="20"
                            Margin="20,10,20,224"
                            HorizontalAlignment="Center"
                            Effect="{StaticResource ShadowEffect}">

                            <StackPanel HorizontalAlignment="Center">

                                <!-- Profile Image -->
                                <Grid Width="120" Height="120" Margin="0,0,0,10">
                                    <Ellipse Fill="White"/>
                                    <Ellipse Stroke="White" StrokeThickness="2">
                                        <Ellipse.Fill>
                                            <ImageBrush x:Name="ProfileImage" Stretch="UniformToFill"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </Grid>

                                <StackPanel x:Name="UsernamePanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,4"/>
                                
                                <!-- Buttons -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                                    <Button x:Name="DeleteProfilePicture"
                                            Content="Delete"
                                            FontSize="10"
                                            Padding="6,2"
                                            Margin="4,0"
                                            Background="#DC2626"
                                            Foreground="White"
                                            Click="DeleteProfilePicture_Click"
                                            Visibility="Collapsed"
                                            BorderThickness="0"
                                            Cursor="Hand"/>
                                    <Button x:Name="ChangeProfilePicture"
                                            Content="Change"
                                            FontSize="10"
                                            Padding="6,2"
                                            Margin="4,0"
                                            Background="White"
                                            Foreground="#16A34A"
                                            Click="ChangeProfilePicture_Click"
                                            Visibility="Collapsed"
                                            BorderBrush="#16A34A"
                                            BorderThickness="1"
                                            Cursor="Hand"/>
                                </StackPanel>

                                <!-- ADMIN Label -->
                                <TextBlock x:Name="AdminLabel"
                                           Text="ADMIN"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="red"
                                           HorizontalAlignment="Center"
                                           Visibility="Collapsed"/>

                                <!-- GET VERIFIED BUTTON -->
                                <Button x:Name="GetVerifiedButton"
                                        Content="Get Verified"
                                        Background="#FACC15"
                                        Foreground="#000"
                                        Padding="8,4"
                                        Margin="0,8,0,0"
                                        FontWeight="Bold"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Visibility="Collapsed"
                                        Click="GetVerifiedButton_Click"/>
                            </StackPanel>
                        </Border>


                        <!-- Right: user input form -->
                        <StackPanel Grid.Column="1" Margin="30">
                            <!-- HEIGHT / WEIGHT / BMI -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Height" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <TextBox x:Name="HeightBox" IsEnabled="False"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                    <TextBlock Text="Height Unit" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <TextBlock x:Name="HeightUnitLabel" Text="cm" FontWeight="Normal" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="BMI" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <TextBlock x:Name="BMIValue" Text="--.--" FontSize="18" FontWeight="Bold" Foreground="#2563EB"/>
                                </StackPanel>
                            </Grid>

                            <!-- WEIGHT / CALORIES -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Weight" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <TextBox x:Name="WeightBox" IsEnabled="False"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                    <TextBlock Text="Weight Unit" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <TextBlock x:Name="WeightUnitLabel" Text="kg" FontWeight="Normal" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Daily Calories" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <TextBlock x:Name="CaloriesValue" Text="--" FontSize="18" FontWeight="Bold" Foreground="#16A34A"/>
                                </StackPanel>
                            </Grid>

                            <!-- GOALS / DIET / SERVINGS -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Weight Goal" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <ComboBox x:Name="GoalComboBox" IsEnabled="False">
                                    <ComboBoxItem Content="Maintain Weight" IsSelected="True"/>
                                    <ComboBoxItem Content="Lose Weight"/>
                                    <ComboBoxItem Content="Gain Weight"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Diet Type" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <ComboBox x:Name="DietComboBox" IsEnabled="False">
                                    <ComboBoxItem Content="Omnivore" IsSelected="True"/>
                                    <ComboBoxItem Content="Paleo"/>
                                    <ComboBoxItem Content="Vegan"/>
                                    <ComboBoxItem Content="Keto"/>
                                    <ComboBoxItem Content="Vegetarian"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- ALLERGIES -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Allergies" FontWeight="SemiBold" Margin="0,0,0,5"/>

                                <!-- Currently selected allergies -->
                                <WrapPanel x:Name="AllergyList" Margin="0,0,0,10"/>

                                <!-- Predefined allergy selector (visible only in edit mode) -->
                                <WrapPanel x:Name="AllergySelector" Margin="0,0,0,10" Visibility="Collapsed"/>

                            </StackPanel>


                            <!-- ACTION BUTTONS -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                                <Button x:Name="EditProfileButton" 
                                    Content="Change Profile" 
                                    Background="#3B82F6" 
                                    Foreground="White" 
                                    Padding="12,6" 
                                    BorderBrush="{x:Null}" 
                                    FontWeight="Bold" 
                                    Margin="0,0,10,0" 
                                    Click="EditProfile_Click"/>
                                <Button x:Name="SaveChangesButton" 
                                    Content="Save Changes" 
                                    Background="#16A34A" 
                                    Foreground="White" 
                                    Padding="12,6" 
                                    BorderBrush="{x:Null}" 
                                    FontWeight="Bold" 
                                    Margin="0,0,10,0" 
                                    Click="SaveChanges_Click"
                                    Visibility="Collapsed"/>

                                <Button x:Name="DeleteAccountButton"
                                    Content="Delete Account" 
                                    Background="#DC2626" 
                                    Foreground="White" 
                                    Padding="12,6" 
                                    BorderBrush="{x:Null}" 
                                    FontWeight="Bold" 
                                    Margin="0,0,10,0" 
                                    Click="DeleteAccount_Click"
                                    Visibility="Collapsed"/>

                                <Button x:Name="ToggleUnitButton"
                                    Content="Switch Units" 
                                    Background="#6B7280" 
                                    Foreground="White" 
                                    Padding="12,6"
                                    Margin="0,0,10,0" 
                                    BorderBrush="{x:Null}" 
                                    FontWeight="Bold" 
                                    Click="ToggleUnit_Click" 
                                    Visibility="Collapsed"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Border>
</UserControl>
