<Window x:Class="HealthyMealPlanner.Views.Profile.CompleteProfileStepFourView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Complete Profile - Step Four"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        AllowsTransparency="True"
        WindowStyle="None">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F0FDF4" Offset="0"/>
            <GradientStop Color="#FFFFFF" Offset="0.5"/>
            <GradientStop Color="#DCFCE7" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Grid>
        <!-- Header -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="24,24,0,0" VerticalAlignment="Top">
            <Border Background="#BBF7D0" Padding="8" CornerRadius="20" VerticalAlignment="Center">
                <Viewbox Width="24" Height="24">
                    <Canvas Width="24" Height="24">
                        <Image Source="/Icons/broccoli.png" Width="24" Height="24"/>
                    </Canvas>
                </Viewbox>
            </Border>
            <TextBlock Text="Healthy Meal Planner" Foreground="#166534" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- Main  -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,100,0,0">
            <TextBlock Text="Upload a profile picture" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="#15803D" 
                       TextAlignment="Center" 
                       Margin="0,0,0,24"/>

            <Ellipse Width="180" Height="180" Stroke="#15803D" StrokeThickness="3" x:Name="ProfileImageEllipse" Margin="0,0,0,10">
                <Ellipse.Fill>
                    <ImageBrush x:Name="ProfileImage" Stretch="UniformToFill"/>
                </Ellipse.Fill>
            </Ellipse>

            <Button Content="Choose Image..." Width="200" Height="40" Margin="0,0,0,24"
                    Background="#15803D" Foreground="White" FontWeight="Bold" FontSize="14"
                    Click="ChooseImageButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="14">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#166534"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center" 
                        Margin="0,24,0,24">
                <Ellipse Width="12" Height="12" Stroke="#15803D" StrokeThickness="2" Fill="Transparent" Margin="0,0,8,0"/>
                <Ellipse Width="12" Height="12" Stroke="#15803D" StrokeThickness="2" Fill="Transparent" Margin="0,0,8,0"/>
                <Ellipse Width="12" Height="12" Stroke="#15803D" StrokeThickness="2" Fill="Transparent" Margin="0,0,8,0"/>
                <Ellipse Width="12" Height="12" Fill="#15803D" Margin="0,0,8,0"/>
                <Ellipse Width="12" Height="12" Stroke="#15803D" StrokeThickness="2" Fill="Transparent" Margin="0,0,8,0"/>
            </StackPanel>

            <!-- Navigation  -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton" 
                        Content="Back" 
                        Click="BackButton_Click"
                        Grid.Column="0"
                        Margin="0,0,10,0"
                        Height="44"
                        FontSize="16"
                        FontWeight="Bold"
                        Background="#15803D"
                        Foreground="White"
                        BorderThickness="0"/>

                <Button x:Name="NextButton" 
                        Content="Next" 
                        Click="NextButton_Click"
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        Height="44"
                        FontSize="16"
                        FontWeight="Bold"
                        Background="#15803D"
                        Foreground="White"
                        BorderThickness="0"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
