<Window x:Class="HealthyMealPlanner.Views.Profile.CompleteProfileStepFiveView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Complete Profile - Step Five"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        AllowsTransparency="True"
        WindowStyle="None">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F0FDF4" Offset="0"/>
            <GradientStop Color="#FFFFFF" Offset="0.5"/>
            <GradientStop Color="#DCFCE7" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="24,24,0,0" VerticalAlignment="Top">
            <Border Background="#BBF7D0" Padding="8" CornerRadius="20" VerticalAlignment="Center">
                <Viewbox Width="24" Height="24">
                    <Canvas Width="24" Height="24">
                        <Image Source="/Icons/broccoli.png" Width="24" Height="24"/>
                    </Canvas>
                </Viewbox>
            </Border>
            <TextBlock Text="Healthy Meal Planner" Foreground="#166534" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>
        
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,100,0,0">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,40">
                <TextBlock Text="Let's get to know you better" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Foreground="#15803D" 
                           TextAlignment="Center" 
                           Margin="0,0,0,24"/>
                
                <TextBlock Text="What's your activity level?" 
                           FontSize="18" 
                           FontWeight="Bold" 
                           Foreground="#15803D" 
                           Margin="0,0,0,12"/>
                <StackPanel Margin="0,0,0,24">
                    <ComboBox x:Name="ActivityLevelBox" 
                              Padding="10" 
                              FontSize="16"
                              Width="320">
                        <ComboBoxItem Content="Sedentary (little or no exercise)"/>
                        <ComboBoxItem Content="Lightly active (light exercise 1-3 days/week)"/>
                        <ComboBoxItem Content="Moderately active (moderate exercise 3-5 days/week)"/>
                        <ComboBoxItem Content="Very active (hard exercise 6-7 days/week)"/>
                        <ComboBoxItem Content="Extra active (very hard exercise and physical job)"/>
                    </ComboBox>
                </StackPanel>

                <TextBlock Text="What are your current measurements?" 
                           FontSize="18" 
                           FontWeight="Bold" 
                           Foreground="#15803D" 
                           Margin="0,0,0,12"/>
                <StackPanel Margin="0,0,0,24">
                    <TextBlock x:Name="HeightLabel" Text="Height (cm)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="HeightBox" 
                             Padding="10" 
                             FontSize="16"
                             Width="320"
                             Margin="0,0,0,12"/>

                    <TextBlock x:Name="WeightLabel" Text="Weight (kg)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="WeightBox" 
                             Padding="10" 
                             FontSize="16"
                             Width="320"/>
                    
                </StackPanel>
                <Button Content="Switch to Imperial" x:Name="UnitToggleButton"
                Width="160" Margin="0,0,0,20"
                Click="UnitToggleButton_Click"/>


                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center" 
                            Margin="0,24,0,24">
                    <Ellipse Width="12" Height="12" Stroke="#15803D" StrokeThickness="2" Fill="Transparent" Margin="0,0,8,0"/>
                    <Ellipse Width="12" Height="12" Stroke="#15803D" StrokeThickness="2" Fill="Transparent" Margin="0,0,8,0"/>
                    <Ellipse Width="12" Height="12" Stroke="#15803D" StrokeThickness="2" Fill="Transparent" Margin="0,0,8,0"/>
                    <Ellipse Width="12" Height="12" Stroke="#15803D" StrokeThickness="2" Fill="Transparent" Margin="0,0,8,0"/>
                    <Ellipse Width="12" Height="12" Fill="#15803D" Margin="0,0,8,0"/>
                </StackPanel>

                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BackButton" 
                            Content="Back" 
                            Click="BackButton_Click"
                            Grid.Column="0"
                            Margin="0,0,10,0"
                            Height="44"
                            FontSize="16"
                            FontWeight="Bold"
                            Background="#15803D"
                            Foreground="White"
                            BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#15803D"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="16"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="14"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    BorderBrush="{TemplateBinding BorderBrush}">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#166534"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button x:Name="NextButton" 
                            Content="Next" 
                            Click="NextButton_Click"
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            Height="44"
                            FontSize="16"
                            FontWeight="Bold"
                            Background="#15803D"
                            Foreground="White"
                            BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#15803D"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="16"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="14"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    BorderBrush="{TemplateBinding BorderBrush}">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#166534"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window> 
