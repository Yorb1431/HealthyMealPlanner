<Window x:Class="HealthyMealPlanner.Views.EditUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit User"
        Height="600"
        Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F9FAFB"
        WindowStyle="ToolWindow">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Profile Image -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,10">
            <Grid Width="120" Height="120">
                <Ellipse Stroke="White" StrokeThickness="2" x:Name="ProfileImage" />
            </Grid>
            <TextBlock x:Name="WindowTitle"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#111827"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
            <StackPanel Margin="0,0,10,20">
                <Label Content="Full Name" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="FullNameBox" Margin="0,0,0,16" Padding="6" BorderBrush="#D1D5DB" Background="White" BorderThickness="1" />

                <Label Content="Age" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="AgeBox" Margin="0,0,0,16" Padding="6" BorderBrush="#D1D5DB" Background="White" BorderThickness="1" />

                <Label Content="Gender" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="GenderCombo" Margin="0,0,0,16" Padding="6" BorderBrush="#D1D5DB" Background="White" BorderThickness="1">
                    <ComboBoxItem Content="Male"/>
                    <ComboBoxItem Content="Female"/>
                    <ComboBoxItem Content="Other"/>
                </ComboBox>

                <Label Content="Activity Level" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="ActivityCombo" Margin="0,0,0,16" Padding="6" BorderBrush="#D1D5DB" Background="White" BorderThickness="1">
                    <ComboBoxItem Content="Sedentary (little or no exercise)"/>
                    <ComboBoxItem Content="Lightly active (light exercise 1-3 days/week)"/>
                    <ComboBoxItem Content="Moderately active (moderate exercise 3-5 days/week)"/>
                    <ComboBoxItem Content="Very active (hard exercise 6-7 days/week)"/>
                    <ComboBoxItem Content="Extra active (very hard exercise and physical job)"/>
                </ComboBox>

                <Label Content="Diet Type" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="DietCombo" Padding="6" BorderBrush="#D1D5DB" Background="White" BorderThickness="1">
                    <ComboBoxItem Content="Omnivore"/>
                    <ComboBoxItem Content="Vegetarian"/>
                    <ComboBoxItem Content="Vegan"/>
                    <ComboBoxItem Content="Pescatarian"/>
                    <ComboBoxItem Content="Keto"/>
                </ComboBox>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save"
                    Width="90"
                    Padding="6"
                    Margin="0,0,10,0"
                    Background="#16A34A"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderBrush="{x:Null}"
                    Click="SaveButton_Click"/>
            <Button Content="Cancel"
                    Width="90"
                    Padding="6"
                    Background="#E5E7EB"
                    Foreground="#111827"
                    FontWeight="Bold"
                    BorderBrush="{x:Null}"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
