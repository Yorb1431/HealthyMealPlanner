<Window x:Class="HealthyMealPlanner.Views.BrowseIngredientsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Browse Ingredients"
        Height="500"
        Width="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <Button Content="Confirm Selection"
                DockPanel.Dock="Bottom"
                Background="#16A34A"
                Foreground="White"
                Height="40"
                Margin="0,10,0,0"
                Click="ConfirmButton_Click"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto" DockPanel.Dock="Top">
            <WrapPanel x:Name="IngredientWrapPanel" Margin="0,0,0,10" />
        </ScrollViewer>
    </DockPanel>
</Window>
