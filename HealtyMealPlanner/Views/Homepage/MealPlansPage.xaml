<UserControl x:Class="HealthyMealPlanner.Views.MealPlansPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <DropShadowEffect x:Key="ShadowEffect"
                          BlurRadius="8"
                          ShadowDepth="2"
                          Color="Black"
                          Opacity="0.2"/>
    </UserControl.Resources>

    <Border CornerRadius="20"
            Background="#F9FAFB"
            Padding="20"
            Margin="20"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            Effect="{StaticResource ShadowEffect}">

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">

                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Button Content="←" Width="40" Height="40" FontSize="20"
                        Background="White" Foreground="#16A34A"
                        BorderBrush="#D1D5DB" BorderThickness="1"
                        Cursor="Hand" Click="BackButton_Click"
                        Margin="0,0,10,0"/> 
                    <TextBlock Text="📅 Your Meal Plans"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#16A34A"
                           VerticalAlignment="Center"/> 
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,0,0,10">
                    <Button Content="🔄"
                        Width="56"
                        Height="56"
                        FontSize="26"
                        FontWeight="Bold"
                        Background="#16A34A"
                        Foreground="White"
                        BorderThickness="0"
                        Margin="0,0,10,0"
                        Cursor="Hand"
                        ToolTip="Refresh Meal Plans"
                        Click="RefreshButton_Click"/> 
                    <Button Content="➕"
                        Width="56"
                        Height="56"
                        FontSize="26"
                        FontWeight="Bold"
                        Background="#16A34A"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Create New Meal Plan"
                        Click="CreateNewPlan_Click"/> 
                </StackPanel>

                <ItemsControl x:Name="MealPlansList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" 
                                    CornerRadius="10"
                                    BorderBrush="#D1D5DB"
                                    BorderThickness="1"
                                    Margin="0,0,0,16"
                                    Padding="12"
                                    Effect="{StaticResource ShadowEffect}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="Bold"
                                                   FontSize="18"
                                                   Foreground="#111827"/>
                                        <TextBlock Text="{Binding CreatedDate}"
                                                   FontSize="14"
                                                   Foreground="#6B7280"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right">
                                        <Button Content="👁" Width="36" Height="36" Margin="5" Background="White" ToolTip="View" Click="ViewPlan_Click" Tag="{Binding MealPlanID}"/>
                                        <Button Content="✏️" Width="36" Height="36" Margin="5" Background="White" ToolTip="Edit" Click="EditPlan_Click" Tag="{Binding MealPlanID}"/>
                                        <Button Content="🗑" Width="36" Height="36" Margin="5" Background="White" ToolTip="Delete" Click="DeletePlan_Click" Tag="{Binding MealPlanID}"/>

                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
