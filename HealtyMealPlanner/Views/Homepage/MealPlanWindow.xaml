<Window x:Class="HealthyMealPlanner.Views.MealPlannerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Meal Plan"
        Width="800"
        Height="600"
        Background="#F9FAFB"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="NoHoverButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="16" Padding="16" BorderBrush="#D1D5DB" BorderThickness="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <DockPanel Margin="0,0,0,16">
                    <TextBlock Text="📅 Your Weekly Meal Plan"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#16A34A"
                               VerticalAlignment="Center"/>
                    <Button Content="✕"
                            Width="30" Height="30"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Right"
                            Click="Close_Click"
                            Background="#F3F4F6"
                            BorderThickness="0"
                            Margin="10,0,20,0"/>
                </DockPanel>

                <ItemsControl ItemsSource="{Binding MealPlan}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="{Binding Key}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#374151"
                                           Margin="0,0,0,8"/>

                                <ItemsControl ItemsSource="{Binding Value}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel HorizontalAlignment="Left"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="12"
                                                    Background="White"
                                                    BorderBrush="LightGray"
                                                    BorderThickness="1"
                                                    Margin="10"
                                                    Width="180"
                                                    Height="260"
                                                    SnapsToDevicePixels="True">
                                                <Button Style="{StaticResource NoHoverButtonStyle}" Click="Meal_Click">
                                                    <Grid Height="260" Width="180">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="100"/>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <Border Grid.Row="0" CornerRadius="12,12,0,0" ClipToBounds="True">
                                                            <Grid Width="180" Height="100">
                                                                <Image Source="{Binding Recipe.ImagePath}"
                                                                       Stretch="UniformToFill"
                                                                       HorizontalAlignment="Stretch"
                                                                       VerticalAlignment="Stretch">
                                                                    <Image.Clip>
                                                                        <RectangleGeometry RadiusX="12" RadiusY="12" Rect="0,0,180,100"/>
                                                                    </Image.Clip>
                                                                </Image>
                                                            </Grid>
                                                        </Border>

                                                        <StackPanel Grid.Row="1" Margin="8,4,8,4">
                                                            <TextBlock Text="{Binding Recipe.Title}"
                                                                       FontWeight="Bold" FontSize="14"
                                                                       TextAlignment="Center" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Recipe.Description}"
                                                                       FontSize="12" Foreground="Gray"
                                                                       TextAlignment="Center" TextWrapping="Wrap"
                                                                       Height="45" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        
                                                        

                                                        <StackPanel Grid.Row="2" Margin="8,0,8,6">
                                                            <TextBlock Text="{Binding Recipe.MetaTime}" FontSize="11" Foreground="DimGray"/>
                                                            <TextBlock Text="{Binding Recipe.MetaServings}" FontSize="11" Foreground="DimGray"/>
                                                            <TextBlock Text="{Binding Recipe.MetaCalories}" FontSize="11" Foreground="DimGray"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button x:Name="SaveButton"
                        Content="💾 Save Meal Plan"
                        Width="200"
                        HorizontalAlignment="Center"
                        Background="#16A34A"
                        Foreground="White"
                        FontWeight="Bold"
                        Padding="10"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="0,10,0,0"
                        Click="SaveMealPlan_Click"/> 

            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
