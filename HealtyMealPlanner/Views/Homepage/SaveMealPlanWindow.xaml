<Window x:Class="HealthyMealPlanner.Views.SaveMealPlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save Meal Plan"
        Width="400"
        Height="250"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True">

    <Border Background="White" CornerRadius="16" Padding="20" BorderBrush="#D1D5DB" BorderThickness="1">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="💾 Save Meal Plan" FontSize="22" FontWeight="Bold" Foreground="#16A34A" TextAlignment="Center" Margin="0,0,0,10"/>

            <TextBlock Text="Give your meal plan a name:" FontSize="13" Foreground="Gray" Margin="0,0,0,14"/>

            <TextBox x:Name="PlanNameBox" Width="240" Height="30" FontSize="14" Margin="0,0,0,20" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#F3F4F6" BorderBrush="#D1D5DB"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Cancel" Width="100" Margin="6" Background="#E5E7EB" BorderThickness="0" Click="Cancel_Click"/>
                <Button Content="Save" Width="100" Margin="6" Background="#16A34A" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
