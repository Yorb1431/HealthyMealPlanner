<UserControl x:Class="HealthyMealPlanner.Views.Dashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <DropShadowEffect x:Key="ShadowEffect"
                          BlurRadius="10"
                          ShadowDepth="2"
                          Color="Black"
                          Opacity="0.2"/>
    </UserControl.Resources>

    <Border CornerRadius="20"
            Background="#F9FAFB"
            Padding="20"
            Margin="20"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            Effect="{StaticResource ShadowEffect}">

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,20">
                    <Button Content="←" Width="40" Height="40" FontSize="20" Background="White" Foreground="#16A34A"
                            BorderBrush="#D1D5DB" BorderThickness="1" Cursor="Hand" Click="BackButton_Click" Margin="0,0,10,0"/>
                    <TextBlock Text="📊 Admin Dashboard"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#16A34A"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="Overview of system activity, users, and health data"
                           FontSize="14"
                           Foreground="Gray"
                           Margin="0,0,0,30"/>
                <TextBlock Text="👥 User Summary"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#111827"
                           Margin="0,0,0,10"/>
                <ListView x:Name="UserList"
                          Height="200"
                          Background="White"
                          BorderBrush="#D1D5DB"
                          BorderThickness="1"
                          Margin="0,0,0,30"/>
                <WrapPanel Margin="0,0,0,20">
                    <Button x:Name="EditButton" Content="✏️ Edit User" Padding="10,5" Margin="5" Background="#3B82F6" Foreground="White" Click="EditButton_Click" Visibility="Collapsed"/>
                    <Button x:Name="ViewButton" Content=" 👁 View User" Padding="10,5" Margin="5" Background="#3B82F6" Foreground="White" Click="ViewUserButton_Click" Visibility="Collapsed"/>
                    <Button x:Name="DeleteButton" Content="❌ Delete User" Padding="10,5" Margin="5" Background="#EF4444" Foreground="White" Click="DeleteButton_Click" Visibility="Collapsed"/>
                    <Button x:Name="ClearMealPlans" Content="Clear Meal Plans" Padding="10,6" Margin="5" Background="#DC2626" Foreground="White" Visibility="Collapsed" Click="ClearMealPlans_Click"/>
                </WrapPanel>

                <TextBlock Text="📈 System Statistics"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#111827"
                           Margin="0,0,0,10"/>

                <UniformGrid Columns="3" Margin="0,0,0,30">
                    <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1" Padding="10" Margin="5">
                        <StackPanel>
                            <TextBlock Text="Active Users (7d)" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock x:Name="ActiveUsersText" Text="Loading..." FontSize="16" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1" Padding="10" Margin="5">
                        <StackPanel>
                            <TextBlock Text="Total Meals" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock x:Name="TotalMealsText" Text="Loading..." FontSize="16" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1" Padding="10" Margin="5">
                        <StackPanel>
                            <TextBlock Text="Meal Plans Generated" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock x:Name="MealPlansText" Text="Loading..." FontSize="16" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
