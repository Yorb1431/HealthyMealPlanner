<Window x:Class="HealthyMealPlanner.Views.EditMealPlanView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Meal Plan"
        Width="800"
        Height="600"
        WindowStartupLocation="CenterScreen"
        Background="#F9FAFB"
        ResizeMode="NoResize"
        WindowStyle="None">

    <Border Background="White" CornerRadius="16" Padding="16" BorderBrush="#D1D5DB" BorderThickness="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <DockPanel Margin="0,0,0,16">
                    <TextBlock Text="✏️ Edit Your Meal Plan"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#16A34A"
                               VerticalAlignment="Center"/>
                    <Button Content="✕"
                            Width="30" Height="30"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Right"
                            Click="Close_Click"
                            Background="#F3F4F6"
                            BorderThickness="0"
                            Margin="10,0,20,0"/>
                </DockPanel>
                <ItemsControl x:Name="MealPlanEditor" />
                <Button x:Name="SaveButton" 
                    Content="💾 Save Changes"
                    Width="160"
                    Height="36"
                    Background="#16A34A"
                    Foreground="White"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0"
                    Click="Save_Click"/> 

            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
