<Window x:Class="HealthyMealPlanner.Views.RecipeView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="Height"
        Width="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="#F9FAFB" CornerRadius="20" Padding="0" ClipToBounds="True">
        <DockPanel LastChildFill="True">
            <Border Height="200"
                        DockPanel.Dock="Top"
                        CornerRadius="20,20,0,0"
                        ClipToBounds="True"
                        Background="Transparent"> 
                <Grid>
                    <Border Height="200"
                            DockPanel.Dock="Top"
                            CornerRadius="20,20,0,0"
                            ClipToBounds="True"
                            Background="Transparent"> 
                        <Grid ClipToBounds="True">
                            <Grid Height="200" ClipToBounds="True">
                                <Grid.Background>
                                    <ImageBrush ImageSource="{Binding ImagePath}"
                                        Stretch="UniformToFill"
                                        AlignmentX="Center"
                                        AlignmentY="Center"/>
                                </Grid.Background>
                                <Grid.Clip>
                                    <RectangleGeometry Rect="0,0,700,200" RadiusX="20" RadiusY="20"/>
                                </Grid.Clip>
                            </Grid>
                            
                            <Button Width="32" Height="32"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Content="X"
                                    Background="white"
                                    Foreground="black"
                                    BorderBrush="Transparent"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="10"
                                    Cursor="Hand"
                                    Click="Close_Click"> 
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="16" Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="FavoriteButton"
                                    Width="32" Height="32"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Content="☆"
                                    Background="White"
                                    Foreground="Black"
                                    BorderBrush="Transparent"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="10"
                                    Cursor="Hand"
                                    Click="Favorite_Click"> 
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="16" Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                        </Grid>
                    </Border>

                    <Button Width="32" Height="32"
                        FontSize="11"
                        FontWeight="Bold"
                        Content="X"
                        Background="white"
                        Foreground="black"
                        BorderBrush="Transparent"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="10"
                        Cursor="Hand"
                        Click="Close_Click"> 
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="16" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <TextBlock x:Name="TitleBlock" FontSize="24" FontWeight="Bold" Foreground="#16A34A" Margin="0,0,0,10"/>
                    <TextBlock x:Name="SubtitleBlock" FontSize="14" Foreground="Gray" Margin="0,0,0,20" TextWrapping="Wrap"/>

                    <StackPanel Margin="0,0,0,10">
                        <Grid HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="🕒 Prep Time" Grid.Column="0" FontWeight="Bold" Foreground="black" FontSize="13" HorizontalAlignment="Center"/>
                            <TextBlock Text="🍳 Cook Time" Grid.Column="1" FontWeight="Bold" Foreground="black" FontSize="13" HorizontalAlignment="Center"/>
                            <TextBlock Text="👥 Servings" Grid.Column="2" FontWeight="Bold" Foreground="black" FontSize="13" HorizontalAlignment="Center"/>
                            <TextBlock Text="🔥 Calories" Grid.Column="3" FontWeight="Bold" Foreground="black" FontSize="13" HorizontalAlignment="Center"/>

                            <TextBlock x:Name="PrepTimeBlock" Grid.Column="0" FontSize="13" Foreground="black" Margin="0,18,0,0" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="CookTimeBlock" Grid.Column="1" FontSize="13" Foreground="black" Margin="0,18,0,0" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="ServingsBlock" Grid.Column="2" FontSize="13" Foreground="black" Margin="0,18,0,0" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="CaloriesBlock" Grid.Column="3" FontSize="13" Foreground="black" Margin="0,18,0,0" HorizontalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <TextBlock Text=" Ingredients" FontWeight="Bold" FontSize="16" Margin="0,20,0,4"/>
                    <ItemsControl x:Name="IngredientsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel IsItemsHost="True"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#DCFCE7"
                                        BorderBrush="#34D399"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Margin="4"
                                        Padding="8,4">
                                    <TextBlock Text="{Binding}" 
                                               Foreground="#065F46"
                                               FontSize="12"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text=" Instructions" FontWeight="Bold" FontSize="16" Margin="0,20,0,4"/>
                    <ItemsControl x:Name="InstructionsList"/>

                    <Button x:Name="AddToMealPlanButton"
                        Content="➕ Add to Meal Plan"
                        Width="160"
                        Height="36"
                        Background="#16A34A"
                        Foreground="White"
                        FontWeight="Bold"
                        Margin="10"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed"
                        Click="AddToMealPlan_Click"/> 

                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
