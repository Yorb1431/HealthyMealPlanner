<Window x:Class="HealthyMealPlanner.Views.SelectPlanTypeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Plan Type"
        Width="320"
        Height="240"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#F9FAFB"
        AllowsTransparency="True">

    <Border Background="White"
            BorderThickness="1"
            BorderBrush="#D1D5DB"
            CornerRadius="20"
            Padding="20"
            Effect="{DynamicResource ShadowEffect}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Select Plan Type"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#16A34A"
                       Margin="0,0,0,20"
                       TextAlignment="Center"/>
            <Button Content="🗓 Weekly Plan"
                    Width="200"
                    Height="40"
                    Background="#16A34A"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Margin="0,0,0,10"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="Weekly_Click"/>
            <Button Content="📅 Day Plan"
                    Width="200"
                    Height="40"
                    Background="White"
                    Foreground="#16A34A"
                    BorderBrush="#16A34A"
                    BorderThickness="1.5"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Click="Day_Click"/>
        </StackPanel>
    </Border>
</Window>
